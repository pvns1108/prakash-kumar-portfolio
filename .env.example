# ── Chatbot backend (api/chat.js on Vercel) ─────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables.
# NEVER put the API key in the website code or in a VITE_ variable.
OPENAI_API_KEY=
# Optional — any OpenAI-compatible API. Defaults shown.
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# Free Google Gemini key instead of OpenAI:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CHAT_MODEL=gemini-2.5-flash
# ALLOWED_ORIGINS=https://pvns1108.github.io,http://localhost:5173
# GITHUB_TOKEN=

# ── Website build (public — only the backend's URL, no secrets) ──────────
# Leave empty to use the built-in answer engine (no AI key needed).
# VITE_CHAT_API_URL=https://your-project.vercel.app/api/chat
